# UrbanHub – Configuration
# Copier ce fichier en .env et remplir les valeurs

# ── Python ────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────
# Identiques à ceux définis dans docker-compose.yml
POSTGRES_HOST=localhost        # "postgres" si lancé depuis Docker
POSTGRES_PORT=5432
POSTGRES_DB=urbanhub
POSTGRES_USER=urbanhub
POSTGRES_PASSWORD=urbanhub

# ── MinIO ─────────────────────────────────────────────────
# Identiques à MINIO_ROOT_USER / MINIO_ROOT_PASSWORD dans docker-compose.yml
USE_MINIO=false
MINIO_ENDPOINT=localhost:9000  # "minio:9000" si lancé depuis Docker
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=urbanhub
MINIO_SECURE=false

# ── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092  # "kafka:9092" si lancé depuis Docker

# ── MQTT ──────────────────────────────────────────────────
MQTT_HOST=localhost  # "mqtt" si lancé depuis Docker
MQTT_PORT=1883

# ── n8n ───────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# ── OpenAQ (Partie 3 – IoT Pollution) ────────────────────
# Clé gratuite sur https://register.openaq.org
OPENAQ_API_KEY=

# ── Pipeline météo (Partie 1) ─────────────────────────────
WORKERS=4
SKIP_DOWNLOAD=false
