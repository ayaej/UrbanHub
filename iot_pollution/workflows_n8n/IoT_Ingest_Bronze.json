    {
      "id": "Function_JSONL",
      "name": "Format JSONL",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [620, 300],
      "parameters": {
        "functionCode": "const item = items[0];\n// On suppose que item.json contient déjà l'événement enrichi envoyé par Python\nconst line = JSON.stringify(item.json) + '\\n';\nreturn [{ json: { line } }];"
      }
    },
    {
      "id": "Convert_To_File",
      "name": "Convert to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1,
      "position": [920, 300],
      "parameters": {
        "property": "line",
        "binaryProperty": "data",
        "fileName": "bronze_iot_openaq.log"
      }
    },
    {
      "id": "Write_File",
      "name": "Append to Bronze File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [1220, 300],
      "parameters": {
        "fileName": "/data/bronze_iot_openaq.log",
        "options": {
          "append": true
        },
        "dataPropertyName": "data"
      }
