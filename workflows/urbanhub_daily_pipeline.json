{
  "name": "UrbanHub – Run Pipeline Météo",
  "active": true,
  "nodes": [

    {
      "id": "trigger-cron",
      "name": "Déclencheur quotidien (2h00)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "rule": "everyDay",
        "hour": 2,
        "minute": 0
      }
    },

    {
      "id": "trigger-manual",
      "name": "Déclencheur manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 480]
    },

    {
      "id": "run-pipeline",
      "name": "Exécuter run_pipeline.py",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 380],
      "parameters": {
        "command": "cd /home/node/pipeline && python3 run_pipeline.py --use-postgres --workers 4 2>&1"
      }
    },

    {
      "id": "check-output",
      "name": "Vérifier le résultat",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [740, 380],
      "parameters": {
        "functionCode": "const output = items[0].json.stdout || '';\nconst exitCode = items[0].json.exitCode;\n\nconst success = exitCode === 0;\n\n// Extrait quelques métriques clés depuis les logs\nconst recordsMatch = output.match(/(\\d+)\\s+records?/i);\nconst records = recordsMatch ? recordsMatch[1] : 'N/A';\n\nconst durationMatch = output.match(/duration[:\\s]+([\\d.]+)\\s*s/i);\nconst duration = durationMatch ? durationMatch[1] + 's' : 'N/A';\n\nreturn [{\n  json: {\n    success,\n    exitCode,\n    records_processed: records,\n    duration,\n    ran_at: new Date().toISOString(),\n    output_preview: output.slice(-800)\n  }\n}];"
      }
    },

    {
      "id": "log-run",
      "name": "Enregistrer le run en base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS pipeline_runs (\n  id         SERIAL PRIMARY KEY,\n  ran_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  success    BOOLEAN     NOT NULL,\n  exit_code  INTEGER,\n  records    TEXT,\n  duration   TEXT,\n  trigger    TEXT\n);\n\nINSERT INTO pipeline_runs (ran_at, success, exit_code, records, duration, trigger)\nVALUES (\n  '{{$json[\"ran_at\"]}}',\n  {{$json[\"success\"]}},\n  {{$json[\"exitCode\"]}},\n  '{{$json[\"records_processed\"]}}',\n  '{{$json[\"duration\"]}}',\n  'n8n'\n);"
      },
      "credentials": {
        "postgres": "UrbanHub Postgres"
      }
    },

    {
      "id": "if-success",
      "name": "Succès ou échec ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 480],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json[\"success\"]}}",
              "value2": true
            }
          ]
        }
      }
    },

    {
      "id": "verify-minio",
      "name": "Vérifier MinIO (santé)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1260, 300],
      "parameters": {
        "url": "http://minio:9000/minio/health/live",
        "method": "GET",
        "options": {
          "timeout": 5000
        }
      }
    },

    {
      "id": "success-response",
      "name": "Pipeline OK",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1260, 460],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "status",  "type": "stringValue", "value": "SUCCESS" },
            { "name": "message", "type": "stringValue", "value": "Pipeline run_pipeline.py terminé avec succès." }
          ]
        }
      }
    },

    {
      "id": "error-response",
      "name": "Pipeline ERREUR",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1260, 620],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            { "name": "status",  "type": "stringValue", "value": "ERROR" },
            { "name": "message", "type": "stringValue", "value": "run_pipeline.py a échoué. Consulter les logs n8n." }
          ]
        }
      }
    }

  ],

  "connections": {
    "Déclencheur quotidien (2h00)": {
      "main": [[{ "node": "Exécuter run_pipeline.py", "type": "main", "index": 0 }]]
    },
    "Déclencheur manuel": {
      "main": [[{ "node": "Exécuter run_pipeline.py", "type": "main", "index": 0 }]]
    },
    "Exécuter run_pipeline.py": {
      "main": [[{ "node": "Vérifier le résultat", "type": "main", "index": 0 }]]
    },
    "Vérifier le résultat": {
      "main": [
        [{ "node": "Enregistrer le run en base", "type": "main", "index": 0 }],
        [{ "node": "Succès ou échec ?",          "type": "main", "index": 0 }]
      ]
    },
    "Enregistrer le run en base": {
      "main": [[{ "node": "Vérifier MinIO (santé)", "type": "main", "index": 0 }]]
    },
    "Succès ou échec ?": {
      "main": [
        [{ "node": "Pipeline OK",    "type": "main", "index": 0 }],
        [{ "node": "Pipeline ERREUR","type": "main", "index": 0 }]
      ]
    }
  },

  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}
