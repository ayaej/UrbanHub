      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "table",
          "rawSql": "SELECT\n  station_name,\n  network,\n  COUNT(*) FILTER (WHERE bikes_available = 0) AS no_bike_count,\n  COUNT(*) FILTER (WHERE free_slots = 0) AS no_slot_count,\n  COUNT(*) AS total_observations,\n  ROUND(COUNT(*) FILTER (WHERE bikes_available = 0)::numeric / COUNT(*) * 100, 1) AS no_bike_pct,\n  MAX(event_timestamp) AS last_seen\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY station_id, station_name, network\nHAVING\n  COUNT(*) FILTER (WHERE bikes_available = 0) > 0\n  OR COUNT(*) FILTER (WHERE free_slots = 0) > 0\nORDER BY GREATEST(no_bike_count, no_slot_count) DESC\nLIMIT 20",
          "refId": "A"
        }
