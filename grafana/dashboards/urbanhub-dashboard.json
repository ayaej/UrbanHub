        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "table",
          "rawSql": "SELECT\n  station_name,\n  network,\n  COUNT(*) FILTER (WHERE bikes_available = 0) AS zero_bike_count,\n  ROUND(COUNT(*) FILTER (WHERE bikes_available = 0)::numeric / COUNT(*) * 100, 1) AS zero_bike_pct,\n  ROUND(AVG(bikes_available)::numeric, 1) AS avg_bikes,\n  COUNT(*) AS samples\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY station_id, station_name, network\nHAVING COUNT(*) FILTER (WHERE bikes_available = 0) > 0\nORDER BY zero_bike_pct DESC\nLIMIT 20",
          "refId": "A"
