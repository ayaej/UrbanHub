        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "table",
          "rawSql": "SELECT\n  station_name,\n  network,\n  ROUND(AVG(bikes_available)::numeric, 1) AS avg_bikes,\n  ROUND(AVG(free_slots)::numeric, 1) AS avg_free_slots,\n  ROUND(ABS(AVG(bikes_available - free_slots))::numeric, 1) AS imbalance_score\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY station_id, station_name, network\nHAVING COUNT(*) >= 2\nORDER BY imbalance_score DESC\nLIMIT 20",
          "refId": "A"
