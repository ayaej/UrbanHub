        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', event_timestamp) AS time,\n  SUM(bikes_available) AS \"Vélos disponibles\",\n  SUM(free_slots) AS \"Places libres\"\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY date_trunc('hour', event_timestamp)\nORDER BY time",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', event_timestamp) AS time,\n  ROUND(AVG(bikes_available::numeric / NULLIF(bikes_available + free_slots, 0)) * 100, 1) AS \"Taux d'utilisation %\"\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY date_trunc('hour', event_timestamp)\nORDER BY time",
          "refId": "B"
        }
      ],
      "title": "Évolution horaire — vélos & taux d'utilisation",
      "type": "timeseries"
    },

