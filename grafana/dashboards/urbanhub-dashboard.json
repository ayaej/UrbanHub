      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
          "format": "table",
          "rawSql": "SELECT\n  station_name,\n  network,\n  ROUND(AVG(bikes_available::numeric / NULLIF(bikes_available + free_slots, 0)) * 100, 1) AS usage_rate_pct,\n  ROUND(AVG(bikes_available)::numeric, 1) AS avg_bikes,\n  COUNT(*) AS samples\nFROM citybikes_station_events\nWHERE $__timeFilter(event_timestamp)\nGROUP BY station_id, station_name, network\nHAVING COUNT(*) >= 2\nORDER BY usage_rate_pct DESC NULLS LAST\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Top 15 — taux d'utilisation",
      "type": "table"
